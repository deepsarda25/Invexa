# Shared
TZ=Asia/Kolkata

# TimescaleDB
POSTGRES_DB=invexa
POSTGRES_USER=invexa
POSTGRES_PASSWORD=invexa_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Kafka
KAFKA_EXTERNAL_PORT=9094

# Backend app
BACKEND_PORT=3000
JWT_SECRET=replace_with_a_long_random_secret
DATABASE_URL=postgres://invexa:invexa_password@localhost:5432/invexa
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=invexa-backend
CORS_ORIGIN=http://localhost:5173
SIM_CONTROL_TOPIC=sim-control
PRICE_TICKS_TOPIC=price-ticks
ORDERS_PLACED_TOPIC=orders-placed
ORDERS_FILLED_TOPIC=orders-filled
COMPETITION_EVENTS_TOPIC=competition-events

# Email (Google SMTP) — used for signup OTP verification, the "account
# created" credentials email, and trade-execution notifications.
# Leave SMTP_HOST unset to run with mail disabled (emails are skipped and
# logged once; nothing else breaks).
#
# To use Gmail SMTP:
#   1. The Google account must have 2-Step Verification turned on.
#   2. Create an "App Password" at https://myaccount.google.com/apppasswords
#      (a normal Gmail password will NOT work here).
#   3. Put that 16-character app password in SMTP_PASS below (no spaces).
#
# SMTP_SECURE must match the port: 465 = true (implicit TLS), 587 = false
# (STARTTLS). Leave it unset and it is derived from the port automatically.
# On boot the server verifies these settings and logs either
# "[mailer] SMTP ready ..." or a specific diagnosis of what's wrong.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=venture.global.info@gmail.com
SMTP_PASS=replace_with_a_gmail_app_password
# Do NOT wrap this in quotes — the value is used verbatim as the From
# header, and surrounding quotes make it a malformed address that mail
# servers reject.
MAIL_FROM=Invexa <venture.global.info@gmail.com>
# Set to false to skip the SMTP credential check at server startup.
MAIL_VERIFY_ON_BOOT=true

# Frontend
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws/prices

# Python sim
SIM_TICK_INTERVAL=1.0
SIM_TICKERS=FAKE,TSIM,NOVA,ALFA,ZENX
SIM_START_PRICE=100.0
SIM_STRATEGY=random_walk
SIM_VOLATILITY=0.02
SIM_DRIFT=0.0005
SIM_MEAN_REVERSION_STRENGTH=0.08
SIM_CIRCUIT_LIMIT=0.03
SIM_KAFKA_BROKERS=localhost:9094
SIM_PRICE_TOPIC=price-ticks
SIM_CONTROL_TOPIC=sim-control
